{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": false,
    "declaration": true,
    "outDir": "./dist",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "emitDeclarationOnly": true
  },
  "include": ["src"]
}
